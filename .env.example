# Copy to .env (never commit .env). All values are optional.

# Optional cloud mirror of the session list (metadata only, frames stay on the PC).
# Supabase -> Project Settings -> API. Use the service_role key ONLY on the collector PC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Start the Wi-Fi secure link automatically (same as: npm run start:wifi)
TUNNEL=0

# Only for the online (Vercel) copy of the dashboard: its exact origin, comma-separated.
# ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,https://your-site.vercel.app
