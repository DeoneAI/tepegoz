{
  "name": "tepegoz",
  "description": "Phone-to-PC sensor acquisition and a roadmap toward road perception and motion-assisted evaluation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env pc/server.mjs",
    "start:wifi": "node --env-file-if-exists=.env pc/server.mjs --tunnel",
    "dev": "node --env-file-if-exists=.env pc/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "vercel --prod"
  },
  "engines": {
    "node": ">=22.13"
  }
}
